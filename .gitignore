# Build artifacts
/nmsbonker
/nmsbonker-gui
/dist/
*.exe

# Coverage
coverage.out
count.out

# Game-derived data must never enter the repository (Hello Games assets).
# Caches, extracted MBIN/MXML, golden fixtures and third-party mod scripts
# live under XDG dirs or in a local, ignored tree.
*.MBIN
*.MXML
*.mbin
*.mxml
*.pak
/golden/
/library/

# Third-party AMUMSS mod scripts belong to their authors and stay in the user's
# library directory. Only this project's own tweaks are committed, so .lua is
# ignored everywhere else as a backstop against a stray import.
*.lua
!/internal/tweaks/scripts/*.lua

# Python bytecode from the reference fixture generator.
__pycache__/
